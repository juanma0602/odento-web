<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>Odento - Asistente WhatsApp para Clínicas Dentales</title>
  <meta name="description" content="Odento: Asistente de WhatsApp para clínicas dentales. Agenda turnos automáticamente, reduce no-shows con recordatorios y reconfirmación. Integración simple y sin diagnósticos.">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
  <script src="https://cdn.tailwindcss.com"></script>
  <script>
    tailwind.config = { theme:{ extend:{ colors:{ primary:'#2563eb', secondary:'#0ea5e9', accent:'#06b6d4', dark:'#1e293b' } } } }
  </script>
  <style>
    @import url('https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700&display=swap');
    body{ font-family:'Poppins',sans-serif; scroll-behavior:smooth; overflow-x:hidden }

    /* ===== Hero video ===== */
    .video-container{ position:relative; width:100%; height:100vh; overflow:hidden; background:#0b1b34 }
    .video-background{
      position:absolute; top:50%; left:50%;
      width:100%; height:100%;
      object-fit:cover;                /* escritorio: llena */
      object-position:50% 50%;
      transform:translate(-50%,-50%);
      z-index:0;
    }
    .video-overlay{
      position:absolute; inset:0;
      background:linear-gradient(to bottom,rgba(0,0,0,.78) 0%,rgba(0,0,0,.22) 50%,rgba(0,0,0,.78) 100%);
      z-index:1; pointer-events:none;
    }

    /* ===== Navbar / Menú ===== */
    .navbar{ background:#2563eb; box-shadow:0 4px 12px rgba(0,0,0,.1) }
    .mobile-menu{ display:none; position:fixed; top:0; right:0; width:280px; height:100%;
      background:rgba(37,99,235,.98); z-index:100; flex-direction:column; padding:80px 20px 20px;
      box-shadow:-5px 0 15px rgba(0,0,0,.2); transform:translateX(100%); transition:transform .3s ease-out }
    .mobile-menu.active{ display:flex; transform:translateX(0) }
    .mobile-menu a{ display:block; padding:15px 20px; margin-bottom:10px; background:rgba(255,255,255,.1);
      border-radius:8px; text-align:center; transition:background .3s }
    .mobile-menu a:hover{ background:rgba(255,255,255,.2) }
    .hamburger{ display:none; cursor:pointer; z-index:101; background:rgba(255,255,255,.2);
      border-radius:50%; width:50px; height:50px; flex-direction:column; justify-content:center; align-items:center }
    .hamburger span{ display:block; width:24px; height:2px; background:white; margin:4px 0; transition:all .3s }
    .hamburger.active span:nth-child(1){ transform:translateY(6px) rotate(45deg) }
    .hamburger.active span:nth-child(2){ opacity:0 }
    .hamburger.active span:nth-child(3){ transform:translateY(-6px) rotate(-45deg) }

    /* ===== Responsive ===== */
    @media (max-width:1024px){
      .desktop-nav{ display:none !important }
      .hamburger{ display:flex }

      /* 📱 MÓVIL: agrandar y encuadrar el calendario sin recortes feos */
      .video-background{
        object-fit:cover;                     /* evita que se vea “chico” (sin letterboxing) */ /* MDN: object-fit cover */
        transform:translate(-50%,-50%);       /* sin scale que reduzca */
        object-position:38% 50%;              /* desplaza foco un poco a la izquierda (calendario) */ /* MDN: object-position */
      }
    }
    @media (max-width:480px) and (orientation:portrait){
      .video-background{
        object-fit:cover;
        transform:translate(-50%,-50%);       /* NO reducir */
        object-position:35% 50%;              /* un toque más de calendario en phones angostos */
      }
    }

    .content-section{ padding:5rem 0 }
    @keyframes fadeIn{ from{opacity:0} to{opacity:1} }
    .animate-fade-in{ animation:fadeIn 1.5s ease-out forwards }
  </style>
</head>
<body class="bg-gray-50">
  <!-- ===== Navbar ===== -->
  <nav class="navbar text-white py-4 px-6 sticky top-0 z-50" role="navigation" aria-label="Principal">
